import os
from flask import Flask, jsonify
from flask_cors import CORS

app = Flask(__name__)
CORS(app)  # Inaruhusu Telegram Mini App kusoma data

@app.route('/api/latest-signal', methods=['GET'])
def get_signal():
    # Hapa ndipo signal ya hivi karibuni kutoka chanzo chako inapowekwa
    signal_data = {
        "pair": "EUR/USD OTC",
        "direction": "BUY",
        "timeframe": "5M",
        "confidence": 88,
        "action": "EXECUTE BUY NOW",
        "reason": "Signal received from Telegram channel."
    }
    return jsonify(signal_data)

if __name__ == '__main__':
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port)
